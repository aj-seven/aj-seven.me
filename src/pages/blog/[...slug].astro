---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const blogEntries = (await getCollection(
    "blog",
  )) as CollectionEntry<"blog">[];
  return blogEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"blog">;
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const formattedDate = entry.data.date
  ? entry.data.date.toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : null;
---

<Layout
  title={`${entry.data.title} | AJ`}
  description={entry.data.description}
  image={entry.data.image}
  type="article"
>
  <article
    class="min-h-screen w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 lg:pt-32 pb-16 lg:pb-24 relative z-10"
  >
    <a
      href="/blog"
      class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full border border-white/10 text-zinc-400 font-bold hover:bg-white/5 hover:text-white transition-all mb-8"
    >
      ← Back to Writings
    </a>

    <header class="mb-8 space-y-4 border-b border-white/10 pb-8">
      {
        entry.data.image && (
          <div class="w-full mb-8 rounded-3xl overflow-hidden border border-white/10 shadow-2xl bg-black/50">
            <img
              src={entry.data.image}
              alt={entry.data.title}
              class="w-full h-auto"
            />
          </div>
        )
      }
      {
        formattedDate && (
          <div class="flex items-center gap-4 mt-2">
            <span class="bg-blue-500/10 border border-blue-500/20 px-4 py-1.5 rounded-lg text-sm text-blue-400 font-semibold tracking-tight">
              {formattedDate}
            </span>
          </div>
        )
      }
      <h1
        class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight text-white leading-tight"
      >
        {entry.data.title}
      </h1>
      {
        entry.data.description && (
          <p class="text-xl text-zinc-400 mt-4 leading-relaxed">
            {entry.data.description}
          </p>
        )
      }
    </header>

    <div
      class="prose prose-invert prose-base md:prose-lg prose-blue max-w-none prose-img:rounded-2xl prose-img:shadow-xl prose-headings:font-bold prose-a:text-blue-400 hover:prose-a:text-blue-300"
    >
      <Content />
    </div>
  </article>
</Layout>
