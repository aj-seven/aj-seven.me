---
import Layout from '../../layouts/Layout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

const posts = (await getCollection('blog')) as CollectionEntry<'blog'>[];
posts.sort((a, b) => {
  if (!a.data.date) return 1;
  if (!b.data.date) return -1;
  return b.data.date.valueOf() - a.data.date.valueOf();
});
---

<Layout title="Writings | Abdul Jaber">
  <section class="min-h-screen w-full flex flex-col items-center max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 lg:pt-32 pb-16 lg:pb-24 relative z-10">
    <div class="flex flex-col w-full">
      <div class="flex flex-col items-center mb-12 text-center mt-2">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-black mb-6 text-white tracking-tighter">
          Writings
        </h1>
        <p class="text-base md:text-lg lg:text-xl text-zinc-500 max-w-2xl mx-auto font-medium">
          Thoughts, technical deep dives, and tutorials on web development, scalable systems, and everything in between.
        </p>
      </div>

      <div class="flex flex-col gap-4 max-w-4xl mx-auto w-full">
        {posts.map((post) => (
          <a
            href={`/blog/${post.slug}`}
            class="flex flex-col sm:flex-row gap-4 sm:gap-6 w-full p-4 sm:p-5 rounded-2xl bg-[#0a0a0a] border border-white/5 hover:border-white/10 hover:bg-[#111111] active:bg-[#151515] active:scale-[0.99] transition-all duration-300 group shadow-xl shadow-black/40"
          >
            {post.data.image && (
              <div class="w-full sm:w-40 sm:h-28 shrink-0 overflow-hidden rounded-xl bg-black/20">
                <img src={post.data.image} alt={post.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              </div>
            )}
            <div class="flex flex-col justify-center flex-1 min-w-0">
              <h2 class="text-xl font-bold text-zinc-200 group-hover:text-blue-400 transition-colors truncate mb-2">
                {post.data.title}
              </h2>
              <p class="text-sm md:text-base text-zinc-400 line-clamp-2 mb-3 leading-relaxed">
                {post.data.description}
              </p>
              {post.data.date && (
                <span class="text-xs text-zinc-500 font-medium tracking-wide uppercase mt-auto">
                  {post.data.date.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                  })}
                </span>
              )}
            </div>
          </a>
        ))}
        
        {posts.length === 0 && (
          <div class="text-zinc-500 py-12 text-center border border-dashed border-white/10 rounded-2xl">
            No posts found. Create a markdown file in src/content/blog/
          </div>
        )}
      </div>
    </div>
  </section>
</Layout>
